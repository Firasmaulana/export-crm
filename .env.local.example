# ============================================================================
# KONFIGURASI SUPABASE — B2B EXPORT CRM (Bumi Sari Lokal & Karaya Living)
# ============================================================================
# Cara mendapatkan kredensial ini:
# 1. Buka https://supabase.com/dashboard dan pilih project Anda
# 2. Masuk ke menu Project Settings (ikon gerigi) -> API
# 3. Salin "Project URL" ke NEXT_PUBLIC_SUPABASE_URL
# 4. Salin "anon / public" key di bawah Project API Keys ke NEXT_PUBLIC_SUPABASE_ANON_KEY
# 5. Simpan file ini dengan nama `.env.local` di root folder project, lalu restart `npm run dev`

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
